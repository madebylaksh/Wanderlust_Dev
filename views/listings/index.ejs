         <!-- padding: 1rem 0rem !important;
    padding-left: 2rem !important;
    padding-right: 4.5rem !important;  -->
        
        
        
        
        <div class="listings-container">
            <div class="row justify-content-center">
                <!-- <h1> All Listings </h1> -->
                <% for (let list of allListings) { %>
                    <div class="col-8 col-lg-3 col-md-4 col-sm-6">
                        <div class="card listing-card">
                            <a class="listing-link" href="/listings/<%-list._id%>">
                                <img src="<%-list.image.url%>" class="card-img-top" alt="...">
                                <div class="card-body">
                                    <p class="card-text">
                                        <b><%- list.title %></b> <br>
                                        &#8377;<%- list.price.toLocaleString("en-IN")%>/ night &nbsp;&nbsp;&nbsp;&nbsp;
                                            <span id="tax-info" hidden> +18% GST </span>
                                    </p>
                                </div>
                            </a>
                        </div>
                    </div>
                    <% } %>

                   

            </div>
        </div>
    </body>
    <script src="/js/taxSwitch.js"></script>