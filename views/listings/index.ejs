                    <i class="fa-solid fa-filter"></i>
                </div>
                <div class="taxToggle me-1 form-check-reverse form-switch py-lg-3 ps-lg-4 pe-lg-5 pt-2">
                    <label class="form-check-label" for="switchCheckDefault">Display taxes</label>
                    <input class="form-check-input" type="checkbox" id="switchCheckDefault">
                </div>
            </div>
